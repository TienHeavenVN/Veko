<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Khai báo chuẩn ChildProcessLauncher của Chromium Content trên Android -->
        <meta-data
            android:name="org.chromium.content.browser.NUM_SANDBOXED_SERVICES"
            android:value="2" />
        <meta-data
            android:name="org.chromium.content.browser.SANDBOXED_SERVICES_NAME"
            android:value="io.veko.browser.chromium.embedder.VekoSandboxedProcessService" />
        <meta-data
            android:name="org.chromium.content.browser.NUM_PRIVILEGED_SERVICES"
            android:value="1" />
        <meta-data
            android:name="org.chromium.content.browser.PRIVILEGED_SERVICES_NAME"
            android:value="io.veko.browser.chromium.embedder.VekoPrivilegedProcessService" />

        <!-- Các tiến trình con cô lập (Renderer / Utility sandbox) cho kiến trúc đa tiến trình Chromium Content -->
        <service
            android:name="io.veko.browser.chromium.embedder.VekoSandboxedProcessService0"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":veko_sandboxed_process0"
            android:useAppZygote="false" />

        <service
            android:name="io.veko.browser.chromium.embedder.VekoSandboxedProcessService1"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":veko_sandboxed_process1"
            android:useAppZygote="false" />

        <!-- Tiến trình con GPU / Network Service tách biệt khỏi tiến trình UI -->
        <service
            android:name="io.veko.browser.chromium.embedder.VekoPrivilegedProcessService0"
            android:exported="false"
            android:isolatedProcess="false"
            android:process=":veko_privileged_process0" />
    </application>
</manifest>
