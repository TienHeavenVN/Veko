---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import PrivacySection from '../components/PrivacySection.astro';
import ScreenshotsSection from '../components/ScreenshotsSection.astro';
import DownloadSection from '../components/DownloadSection.astro';
---

<BaseLayout
  title="Veko Browser — Duyệt web theo nguyên tắc của bạn"
  description="Website giới thiệu chính thức của Veko Browser: trình duyệt Android tối giản, thao tác một tay ở cạnh dưới, cô lập tab riêng tư trên RAM và lưu trữ dữ liệu cục bộ minh bạch."
  canonicalPath="/"
>
  <HeroSection />
  <FeaturesSection />
  <PrivacySection />
  <ScreenshotsSection />
  <DownloadSection />
</BaseLayout>
