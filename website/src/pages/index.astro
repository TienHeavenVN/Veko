---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import ProductShowcaseSection from '../components/ProductShowcaseSection.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import PrivacySection from '../components/PrivacySection.astro';
import TechnologySection from '../components/TechnologySection.astro';
import ScreenshotsSection from '../components/ScreenshotsSection.astro';
import DownloadSection from '../components/DownloadSection.astro';
import FaqSection from '../components/FaqSection.astro';
---

<BaseLayout
  title="Veko Browser — Trình duyệt Android mã nguồn mở gọn trong tầm tay"
  description="Website chính thức của Veko Browser (MPL-2.0): trình duyệt Android sử dụng nhân Mozilla GeckoView, điều hướng một tay cạnh dưới, trần bộ nhớ 6 phiên LRU, tab riêng tư trên RAM và lá chắn Rust adblock-rust."
  canonicalPath="/"
>
  <HeroSection />
  <ProductShowcaseSection />
  <FeaturesSection />
  <PrivacySection />
  <TechnologySection />
  <ScreenshotsSection />
  <DownloadSection />
  <FaqSection />
</BaseLayout>
