---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/url';
---

<BaseLayout
  title="Không tìm thấy trang (404) — Veko Browser"
  description="Trang bạn yêu cầu không tồn tại trên website Veko Browser."
  canonicalPath="/404/"
>
  <section class="flex min-h-[60vh] items-center justify-center px-4 py-20">
    <div class="max-w-md text-center">
      <p class="font-mono text-sm font-bold text-veko-cyan">404</p>
      <h1 class="mt-2 text-3xl font-extrabold text-veko-text">Không tìm thấy trang này</h1>
      <p class="mt-3 text-sm leading-relaxed text-veko-muted">
        Liên kết có thể đã thay đổi hoặc không tồn tại. Bạn có thể quay về trang chủ giới thiệu Veko Browser bên dưới.
      </p>
      <a
        href={withBase('/')}
        class="mt-6 inline-flex items-center justify-center rounded-xl bg-veko-cyan px-5 py-3 text-sm font-bold text-slate-950"
      >
        Về trang chủ Veko Browser
      </a>
    </div>
  </section>
</BaseLayout>
