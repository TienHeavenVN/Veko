---
import BaseLayout from '../layouts/BaseLayout.astro';
import { TriangleAlert, ArrowLeft } from '@lucide/astro';
import {
  PRIVACY_LIMITATIONS,
  PRIVACY_PILLARS,
  VEKO_LICENSE_SPDX,
  VEKO_LICENSE_URL,
  VEKO_REPO_URL,
} from '../data/vekoData';
import { withBase } from '../utils/url';
---

<BaseLayout
  title="Tài liệu Quyền riêng tư & Xử lý Dữ liệu — Veko Browser"
  description="Tài liệu kỹ thuật giải thích cơ chế lưu trữ cục bộ Room SQLite, Chế độ Riêng tư trên RAM, phân quyền theo Origin và các giới hạn bảo vệ mạng thực tế của Veko Browser."
  canonicalPath="/privacy/"
>
  <section class="py-14 sm:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <a
        href={withBase('/')}
        class="inline-flex items-center gap-2 text-sm font-semibold text-veko-cyan hover:underline"
      >
        <ArrowLeft class="h-4 w-4" aria-hidden="true" />
        <span>Quay về trang chủ Veko Browser</span>
      </a>

      <div class="mt-6 rounded-2xl border border-amber-500/45 bg-amber-500/10 p-5">
        <div class="flex items-start gap-3">
          <TriangleAlert class="mt-0.5 h-5 w-5 shrink-0 text-veko-amber" aria-hidden="true" />
          <div class="text-sm leading-relaxed text-veko-text">
            <p class="font-bold text-veko-amber">
              [TÀI LIỆU KỸ THUẬT ĐỐI CHIẾU TỪ MÃ NGUỒN — GIẤY PHÉP {VEKO_LICENSE_SPDX}]
            </p>
            <p class="mt-1 text-veko-muted">
              Tài liệu này tổng hợp trung thực các cơ chế kỹ thuật đã triển khai trong mã nguồn hiện tại của Veko Browser (cấp phép theo{' '}
              <a href={VEKO_LICENSE_URL} target="_blank" rel="noopener noreferrer" class="font-semibold text-veko-cyan underline">
                {VEKO_LICENSE_SPDX}
              </a>
              ) và đánh dấu rõ các thông tin vận hành cần chủ dự án xác nhận thêm khi mở rộng kênh phân phối.
            </p>
          </div>
        </div>
      </div>

      <h1 class="mt-8 text-balance text-3xl font-extrabold tracking-[-0.025em] text-veko-text sm:text-4xl">
        Tài liệu Quyền riêng tư &amp; Xử lý Dữ liệu Veko Browser
      </h1>

      <div class="mt-10 space-y-8">
        <section aria-labelledby="sec-verified" class="space-y-4">
          <h2 id="sec-verified" class="text-xl font-extrabold text-veko-text">
            1. Cơ chế kỹ thuật đã xác minh trong mã nguồn
          </h2>
          <div class="space-y-4">
            {
              PRIVACY_PILLARS.map((item) => (
                <div class="veko-cyber-card rounded-2xl border border-veko-border bg-veko-panel p-5">
                  <span class="font-mono text-[11px] font-bold text-veko-teal">{item.codeTag}</span>
                  <h3 class="mt-1.5 text-base font-bold text-veko-text">{item.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-veko-muted">{item.summary}</p>
                  <p class="mt-3 rounded-xl border border-veko-border/70 bg-veko-surface p-3 font-mono text-xs leading-relaxed text-veko-muted">
                    {item.technicalDetail}
                  </p>
                </div>
              ))
            }
          </div>
        </section>

        <section aria-labelledby="sec-limits" class="space-y-3">
          <h2 id="sec-limits" class="text-xl font-extrabold text-veko-text">
            2. Phạm vi &amp; Giới hạn bảo vệ hiện tại
          </h2>
          <ul class="space-y-2.5 rounded-2xl border border-veko-border bg-veko-panel p-5 text-sm leading-relaxed text-veko-muted">
            {
              PRIVACY_LIMITATIONS.map((lim) => (
                <li class="flex gap-2.5">
                  <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-veko-cyan" />
                  <span>{lim}</span>
                </li>
              ))
            }
          </ul>
        </section>

        <section aria-labelledby="sec-pending" class="space-y-3">
          <h2 id="sec-pending" class="text-xl font-extrabold text-veko-text">
            3. Thông tin vận hành &amp; Liên hệ bảo mật
          </h2>
          <div class="rounded-2xl border border-amber-500/40 bg-veko-panel p-5 text-sm leading-relaxed text-veko-muted">
            <ul class="space-y-3">
              <li>
                <strong class="text-veko-text">Giấy phép kho mã nguồn:</strong> Dự án được phát hành công khai theo giấy phép{' '}
                <a href={VEKO_LICENSE_URL} target="_blank" rel="noopener noreferrer" class="font-semibold text-veko-cyan underline">
                  Mozilla Public License Version 2.0 ({VEKO_LICENSE_SPDX})
                </a>.
              </li>
              <li>
                <strong class="text-veko-amber">[KÊNH TIẾP NHẬN BÁO CÁO]</strong> Hiện tại mọi vấn đề kỹ thuật và quyền riêng tư được tiếp nhận qua trang GitHub Issues tại{' '}
                <a href={`${VEKO_REPO_URL}/issues`} target="_blank" rel="noopener noreferrer" class="font-semibold text-veko-cyan underline">
                  {VEKO_REPO_URL}/issues
                </a>.
              </li>
              <li>
                <strong class="text-veko-amber">[LƯU Ý DỊCH VỤ NHÂN TRÌNH DUYỆT]</strong> Nhân mặc định Mozilla GeckoView có tích hợp các thành phần an toàn web tiêu chuẩn của Gecko; nếu trong tương lai bổ sung danh sách lọc cập nhật từ xa, cơ chế kết nối sẽ được công bố trước khi bật.
              </li>
            </ul>
          </div>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>
