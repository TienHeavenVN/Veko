---
import { Cpu, GitBranch, CircleCheck, Clock, ExternalLink, Layers, FileCode } from '@lucide/astro';
import {
  FEATURE_AUDIT_MATRIX,
  GRADLE_MODULES,
  TECH_STACK_ACTIVE,
  TECH_STACK_ROADMAP,
  VEKO_ARCHITECTURE_DOC_URL,
} from '../data/vekoData';
---

<section id="cong-nghe" aria-labelledby="tech-heading" class="py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end" data-reveal>
      <div class="max-w-3xl">
        <p class="font-mono text-xs font-bold tracking-widest text-veko-cyan uppercase">
          Kiến trúc kỹ thuật • Mozilla GeckoView &amp; 7-Module Native/Kotlin
        </p>
        <h2
          id="tech-heading"
          class="mt-2.5 text-balance text-3xl font-extrabold tracking-[-0.025em] text-veko-text sm:text-4xl"
        >
          Kiến trúc thuần GeckoView tinh gọn, minh bạch từng thành phần mã nguồn
        </h2>
        <p class="mt-3 text-pretty text-base leading-relaxed text-veko-muted">
          Veko được tổ chức thành 7 module Gradle Kotlin DSL độc lập kết hợp Cargo cho Rust và Android NDK Clang++ cho cầu nối C++20 JNI — tuyệt đối không dùng <code>android.webkit.WebView</code> hệ thống và chỉ vận hành trên một nhân trình duyệt duy nhất là Mozilla GeckoView.
        </p>
      </div>

      <div class="shrink-0">
        <a
          href={VEKO_ARCHITECTURE_DOC_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="veko-btn-interactive inline-flex items-center gap-2 rounded-xl border border-veko-border bg-veko-panel px-4 py-2.5 text-sm font-semibold text-veko-cyan hover:border-veko-cyan/60 hover:bg-veko-card-hover"
        >
          <span>Tài liệu kiến trúc GeckoView</span>
          <ExternalLink class="h-4 w-4" aria-hidden="true" />
        </a>
      </div>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-12">
      <!-- Cột trái: Công nghệ đã tích hợp & vận hành ổn định -->
      <div class="space-y-4 lg:col-span-7" data-reveal>
        <div class="flex items-center gap-2 text-sm font-extrabold text-veko-text">
          <Cpu class="h-4 w-4 text-veko-teal" aria-hidden="true" />
          <h3>Đã tích hợp &amp; kiểm thử tự động (Verified)</h3>
        </div>

        <div class="space-y-3.5">
          {
            TECH_STACK_ACTIVE.map((item) => (
              <article class="veko-cyber-card rounded-2xl border border-veko-border bg-veko-panel p-5">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <h4 class="text-base font-bold text-veko-text">{item.name}</h4>
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/15 px-2.5 py-0.5 font-mono text-[11px] font-semibold text-veko-emerald">
                    <CircleCheck class="h-3.5 w-3.5" aria-hidden="true" />
                    <span>{item.versionOrScope}</span>
                  </span>
                </div>
                <p class="mt-2 text-sm leading-relaxed text-veko-muted">{item.role}</p>
              </article>
            ))
          }
        </div>
      </div>

      <!-- Cột phải: Đang phát triển + Sơ đồ 9 Module -->
      <div class="space-y-6 lg:col-span-5" data-reveal>
        <div>
          <div class="flex items-center gap-2 text-sm font-extrabold text-veko-text">
            <GitBranch class="h-4 w-4 text-amber-400" aria-hidden="true" />
            <h3>Đang phát triển (In Development — chưa bật mặc định)</h3>
          </div>

          <div class="mt-4 space-y-3.5">
            {
              TECH_STACK_ROADMAP.map((item) => (
                <article class="veko-cyber-card rounded-2xl border border-amber-500/35 bg-veko-panel p-5">
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <h4 class="text-base font-bold text-veko-text">{item.name}</h4>
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-500/15 px-2.5 py-0.5 font-mono text-[11px] font-semibold text-veko-amber">
                      <Clock class="h-3.5 w-3.5" aria-hidden="true" />
                      <span>{item.versionOrScope}</span>
                    </span>
                  </div>
                  <p class="mt-2 text-sm leading-relaxed text-veko-muted">{item.role}</p>
                </article>
              ))
            }
          </div>
        </div>

        <!-- Bản đồ 7 Module trong settings.gradle.kts -->
        <div class="veko-cyber-card rounded-2xl border border-veko-border bg-veko-panel p-5">
          <div class="flex items-center gap-2 text-xs font-bold tracking-wider text-veko-cyan uppercase">
            <Layers class="h-4 w-4" aria-hidden="true" />
            <h3>Bản đồ 7 Module trong settings.gradle.kts</h3>
          </div>
          <ul class="mt-4 divide-y divide-veko-border/60 text-xs">
            {
              GRADLE_MODULES.map((mod) => (
                <li class="flex items-start justify-between gap-3 py-2.5">
                  <div>
                    <code class="font-mono font-bold text-veko-cyan">{mod.path}</code>
                    <p class="mt-0.5 text-veko-muted">{mod.responsibility}</p>
                  </div>
                  <span
                    class:list={[
                      'shrink-0 rounded-md px-2 py-0.5 font-mono text-[10px] font-semibold',
                      mod.state === 'Hoạt động'
                        ? 'bg-emerald-500/15 text-veko-emerald'
                        : 'bg-amber-500/15 text-veko-amber',
                    ]}
                  >
                    {mod.state}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <!-- Bảng kiểm toán trạng thái kỹ thuật 11 hạng mục cốt lõi đối chiếu từ mã nguồn -->
    <div
      data-reveal
      class="mt-12 overflow-hidden rounded-3xl border border-veko-border bg-veko-panel"
    >
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-veko-border px-6 py-4 sm:px-7">
        <div class="flex items-center gap-2.5">
          <FileCode class="h-5 w-5 text-veko-cyan" aria-hidden="true" />
          <h3 class="text-base font-extrabold text-veko-text sm:text-lg">
            Bảng kiểm toán tính chính xác kỹ thuật đối chiếu trực tiếp mã nguồn
          </h3>
        </div>
        <span class="font-mono text-xs text-veko-muted">
          Verified = Đã triển khai &amp; có kiểm thử • In Development = Đang phát triển
        </span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-veko-border/80 bg-veko-surface text-xs text-veko-muted uppercase">
            <tr>
              <th scope="col" class="px-6 py-3.5 font-bold">Thành phần kỹ thuật</th>
              <th scope="col" class="px-6 py-3.5 font-bold">Trạng thái</th>
              <th scope="col" class="px-6 py-3.5 font-bold">Thực trạng trong mã nguồn</th>
              <th scope="col" class="px-6 py-3.5 font-bold">Bằng chứng tệp nguồn</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-veko-border/60">
            {
              FEATURE_AUDIT_MATRIX.map((row) => (
                <tr class="transition-colors hover:bg-veko-card/40">
                  <td class="px-6 py-4 font-semibold text-veko-text">{row.feature}</td>
                  <td class="px-6 py-4">
                    <span
                      class:list={[
                        'inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 font-mono text-[11px] font-bold',
                        row.status === 'Verified'
                          ? 'bg-emerald-500/15 text-veko-emerald'
                          : 'bg-amber-500/15 text-veko-amber',
                      ]}
                    >
                      {row.status}
                    </span>
                  </td>
                  <td class="px-6 py-4 text-xs leading-relaxed text-veko-muted sm:text-sm">
                    {row.summary}
                  </td>
                  <td class="px-6 py-4 font-mono text-[11px] text-veko-cyan">
                    {row.sourceEvidence}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
