---
import { Cpu, GitBranch, CircleCheck, Clock, ExternalLink, Layers } from '@lucide/astro';
import {
  GRADLE_MODULES,
  TECH_STACK_ACTIVE,
  TECH_STACK_ROADMAP,
  VEKO_AUDIT_DOC_URL,
} from '../data/vekoData';
---

<section id="cong-nghe" aria-labelledby="tech-heading" class="py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end" data-reveal>
      <div class="max-w-3xl">
        <p class="font-mono text-xs font-bold tracking-widest text-veko-cyan uppercase">
          Kiến trúc kỹ thuật • 9-Module Native &amp; Kotlin
        </p>
        <h2
          id="tech-heading"
          class="mt-2.5 text-balance text-3xl font-extrabold tracking-[-0.025em] text-veko-text sm:text-4xl"
        >
          Phân biệt rạch ròi công nghệ đang chạy thực tế và hạng mục trong lộ trình
        </h2>
        <p class="mt-3 text-pretty text-base leading-relaxed text-veko-muted">
          Veko được tổ chức thành 9 module Gradle Kotlin DSL độc lập kết hợp hệ thống biên dịch gốc GN/Ninja cho C++20 và Cargo cho Rust — tuyệt đối không dùng <code>android.webkit.WebView</code> hệ thống.
        </p>
      </div>

      <div class="shrink-0">
        <a
          href={VEKO_AUDIT_DOC_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl border border-veko-border bg-veko-panel px-4 py-2.5 text-sm font-semibold text-veko-cyan transition-colors hover:border-veko-cyan/60 hover:bg-veko-card-hover"
        >
          <span>Tài liệu kiến trúc &amp; lộ trình</span>
          <ExternalLink class="h-4 w-4" aria-hidden="true" />
        </a>
      </div>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-12">
      <!-- Cột trái: Công nghệ đã tích hợp & vận hành ổn định -->
      <div class="space-y-4 lg:col-span-7" data-reveal>
        <div class="flex items-center gap-2 text-sm font-extrabold text-veko-text">
          <Cpu class="h-4 w-4 text-veko-teal" aria-hidden="true" />
          <h3>Đã tích hợp &amp; kiểm thử tự động trong bản dựng hiện tại</h3>
        </div>

        <div class="space-y-3.5">
          {
            TECH_STACK_ACTIVE.map((item) => (
              <article class="rounded-2xl border border-veko-border bg-veko-panel p-5">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <h4 class="text-base font-bold text-veko-text">{item.name}</h4>
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/15 px-2.5 py-0.5 font-mono text-[11px] font-semibold text-veko-emerald">
                    <CircleCheck class="h-3.5 w-3.5" aria-hidden="true" />
                    <span>{item.versionOrScope}</span>
                  </span>
                </div>
                <p class="mt-2 text-sm leading-relaxed text-veko-muted">{item.role}</p>
              </article>
            ))
          }
        </div>
      </div>

      <!-- Cột phải: Lộ trình phát triển + Sơ đồ 9 Module -->
      <div class="space-y-6 lg:col-span-5" data-reveal>
        <div>
          <div class="flex items-center gap-2 text-sm font-extrabold text-veko-text">
            <GitBranch class="h-4 w-4 text-amber-400" aria-hidden="true" />
            <h3>Đang trong lộ trình kỹ thuật (Chưa bật làm mặc định)</h3>
          </div>

          <div class="mt-4 space-y-3.5">
            {
              TECH_STACK_ROADMAP.map((item) => (
                <article class="rounded-2xl border border-amber-500/35 bg-veko-panel p-5">
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <h4 class="text-base font-bold text-veko-text">{item.name}</h4>
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-500/15 px-2.5 py-0.5 font-mono text-[11px] font-semibold text-veko-amber">
                      <Clock class="h-3.5 w-3.5" aria-hidden="true" />
                      <span>{item.versionOrScope}</span>
                    </span>
                  </div>
                  <p class="mt-2 text-sm leading-relaxed text-veko-muted">{item.role}</p>
                </article>
              ))
            }
          </div>
        </div>

        <!-- Bản đồ 9 Module trong settings.gradle.kts -->
        <div class="rounded-2xl border border-veko-border bg-veko-panel p-5">
          <div class="flex items-center gap-2 text-xs font-bold tracking-wider text-veko-cyan uppercase">
            <Layers class="h-4 w-4" aria-hidden="true" />
            <h3>Bản đồ 9 Module trong kho mã nguồn</h3>
          </div>
          <ul class="mt-4 divide-y divide-veko-border/60 text-xs">
            {
              GRADLE_MODULES.map((mod) => (
                <li class="flex items-start justify-between gap-3 py-2.5">
                  <div>
                    <code class="font-mono font-bold text-veko-cyan">{mod.path}</code>
                    <p class="mt-0.5 text-veko-muted">{mod.responsibility}</p>
                  </div>
                  <span
                    class:list={[
                      'shrink-0 rounded-md px-2 py-0.5 font-mono text-[10px] font-semibold',
                      mod.state === 'Hoạt động'
                        ? 'bg-emerald-500/15 text-veko-emerald'
                        : 'bg-amber-500/15 text-veko-amber',
                    ]}
                  >
                    {mod.state}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
