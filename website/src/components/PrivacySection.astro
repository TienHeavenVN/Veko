---
import { ShieldAlert, FileText, CircleCheck } from '@lucide/astro';
import { PRIVACY_PILLARS, PRIVACY_LIMITATIONS } from '../data/vekoData';
import { withBase } from '../utils/url';
---

<section
  id="quyen-rieng-tu"
  aria-labelledby="privacy-heading"
  class="border-y border-veko-border/60 bg-veko-surface/70 py-20 sm:py-24"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-xs font-bold tracking-wider text-veko-teal uppercase">
        Quyền riêng tư trung thực
      </p>
      <h2 id="privacy-heading" class="mt-2 text-3xl font-extrabold tracking-tight text-veko-text sm:text-4xl">
        Giải thích rõ những gì Veko lưu, những gì Veko chặn và giới hạn thực tế
      </h2>
      <p class="mt-3 text-base leading-relaxed text-veko-muted">
        Quyền riêng tư bền vững bắt đầu từ thông tin chính xác thay vì khẩu hiệu phóng đại. Dưới đây là cơ chế xử lý dữ liệu thực tế trong mã nguồn của Veko Browser.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2">
      {
        PRIVACY_PILLARS.map((pillar) => (
          <article class="rounded-2xl border border-veko-border/80 bg-veko-panel p-6">
            <div class="flex items-start gap-3">
              <CircleCheck class="mt-0.5 h-5 w-5 shrink-0 text-veko-teal" aria-hidden="true" />
              <div>
                <h3 class="text-lg font-bold text-veko-text">{pillar.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-veko-text/90">{pillar.summary}</p>
                <p class="mt-3 rounded-xl bg-veko-card/80 p-3 text-xs leading-relaxed text-veko-muted">
                  {pillar.technicalDetail}
                </p>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Khối nêu rõ giới hạn bảo vệ quyền riêng tư hiện tại -->
    <div class="mt-10 rounded-2xl border border-amber-400/35 bg-amber-500/6 p-6 sm:p-7">
      <div class="flex items-start gap-3.5">
        <ShieldAlert class="mt-0.5 h-6 w-6 shrink-0 text-amber-300" aria-hidden="true" />
        <div class="flex-1">
          <h3 class="text-base font-bold text-veko-text sm:text-lg">
            Những giới hạn bảo vệ quyền riêng tư hiện tại bạn cần biết
          </h3>
          <ul class="mt-3 space-y-2.5 text-sm leading-relaxed text-veko-muted">
            {
              PRIVACY_LIMITATIONS.map((item) => (
                <li class="flex gap-2.5">
                  <span aria-hidden="true" class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-300" />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>

          <div class="mt-5">
            <a
              href={withBase('/privacy/')}
              class="inline-flex items-center gap-2 text-sm font-semibold text-veko-cyan hover:underline"
            >
              <FileText class="h-4 w-4" aria-hidden="true" />
              <span>Xem Bản nháp Tài liệu Quyền riêng tư chi tiết</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
