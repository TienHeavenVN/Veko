---
import VekoLogo from './VekoLogo.astro';
import {
  OFFICIAL_RELEASE_VERSION,
  VEKO_ACTIONS_URL,
  VEKO_AUDIT_DOC_URL,
  VEKO_LICENSE_SPDX,
  VEKO_LICENSE_URL,
  VEKO_MIN_ANDROID,
  VEKO_README_URL,
  VEKO_RELEASES_URL,
  VEKO_REPO_URL,
  VEKO_SOURCE_VERSION,
} from '../data/vekoData';
import { withBase } from '../utils/url';

const currentYear = new Date().getFullYear();
const homeBase = withBase('/');
---

<footer class="border-t border-veko-border/85 bg-veko-bg py-14">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-12">
      <!-- Nhận diện thương hiệu & phiên bản -->
      <div class="md:col-span-5">
        <a
          href={homeBase}
          class="inline-flex items-center gap-3 text-lg font-extrabold text-veko-text transition-opacity hover:opacity-90"
        >
          <VekoLogo size={34} gradientId="vekoFooterLogoGrad" />
          <span>Veko Browser</span>
        </a>
        <p class="mt-3 max-w-sm text-sm leading-relaxed text-veko-muted">
          Dự án trình duyệt Android mã nguồn mở chú trọng thao tác một tay ở cạnh dưới, dữ liệu lưu cục bộ trên máy và công khai minh bạch cơ chế bảo vệ quyền riêng tư.
        </p>

        <div class="mt-4 flex flex-wrap items-center gap-2 font-mono text-xs">
          <span class="rounded-lg border border-veko-border bg-veko-panel px-2.5 py-1 text-veko-cyan">
            Source: {VEKO_SOURCE_VERSION}
          </span>
          {OFFICIAL_RELEASE_VERSION && (
            <span class="rounded-lg border border-veko-border bg-veko-panel px-2.5 py-1 text-veko-emerald">
              Release: {OFFICIAL_RELEASE_VERSION}
            </span>
          )}
          <span class="rounded-lg border border-veko-border bg-veko-panel px-2.5 py-1 text-veko-muted">
            {VEKO_MIN_ANDROID}
          </span>
        </div>
      </div>

      <!-- Điều hướng sản phẩm -->
      <div class="md:col-span-2">
        <h2 class="font-mono text-xs font-bold tracking-wider text-veko-text uppercase">
          Sản phẩm
        </h2>
        <ul class="mt-3.5 space-y-2.5 text-sm text-veko-muted">
          <li>
            <a href={`${homeBase}#trai-nghiem`} class="transition-colors hover:text-veko-cyan">
              Trải nghiệm
            </a>
          </li>
          <li>
            <a href={`${homeBase}#tinh-nang`} class="transition-colors hover:text-veko-cyan">
              Tính năng
            </a>
          </li>
          <li>
            <a href={`${homeBase}#cong-nghe`} class="transition-colors hover:text-veko-cyan">
              Công nghệ
            </a>
          </li>
          <li>
            <a href={`${homeBase}#giao-dien`} class="transition-colors hover:text-veko-cyan">
              Minh họa UI
            </a>
          </li>
          <li>
            <a href={`${homeBase}#tai-ung-dung`} class="transition-colors hover:text-veko-cyan">
              Tải về
            </a>
          </li>
        </ul>
      </div>

      <!-- Mã nguồn & Tài liệu -->
      <div class="md:col-span-2">
        <h2 class="font-mono text-xs font-bold tracking-wider text-veko-text uppercase">
          Mã nguồn &amp; Docs
        </h2>
        <ul class="mt-3.5 space-y-2.5 text-sm text-veko-muted">
          <li>
            <a
              href={VEKO_REPO_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="transition-colors hover:text-veko-cyan"
            >
              GitHub Repository
            </a>
          </li>
          <li>
            <a
              href={VEKO_README_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="transition-colors hover:text-veko-cyan"
            >
              Documentation (README)
            </a>
          </li>
          <li>
            <a
              href={VEKO_AUDIT_DOC_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="transition-colors hover:text-veko-cyan"
            >
              Kiến trúc Dual-Engine
            </a>
          </li>
          <li>
            <a
              href={VEKO_RELEASES_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="transition-colors hover:text-veko-cyan"
            >
              GitHub Releases
            </a>
          </li>
          <li>
            <a
              href={VEKO_ACTIONS_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="transition-colors hover:text-veko-cyan"
            >
              CI Build &amp; Emulator
            </a>
          </li>
        </ul>
      </div>

      <!-- Pháp lý, Quyền riêng tư & Giấy phép -->
      <div class="md:col-span-3">
        <h2 class="font-mono text-xs font-bold tracking-wider text-veko-text uppercase">
          Quyền riêng tư &amp; Giấy phép
        </h2>
        <ul class="mt-3.5 space-y-2.5 text-sm text-veko-muted">
          <li>
            <a href={withBase('/privacy/')} class="font-medium text-veko-text transition-colors hover:text-veko-cyan">
              Tài liệu Quyền riêng tư &amp; Xử lý Dữ liệu
            </a>
          </li>
          <li class="text-xs leading-relaxed text-veko-muted">
            <strong class="font-semibold text-veko-text">License:</strong> Phát hành dưới giấy phép{' '}
            <a
              href={VEKO_LICENSE_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="font-mono font-semibold text-veko-cyan hover:underline"
            >
              {VEKO_LICENSE_SPDX} (Mozilla Public License 2.0)
            </a>
            , đồng bộ với nhân Mozilla GeckoView và crate <code>adblock-rust</code>.
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col items-start justify-between gap-3 border-t border-veko-border/70 pt-6 text-xs text-veko-muted sm:flex-row sm:items-center">
      <p>
        &copy; {currentYear} Veko Browser (TienHeavenVN/Veko) • Giấy phép {VEKO_LICENSE_SPDX} • Release {OFFICIAL_RELEASE_VERSION ?? 'dev'} ({VEKO_SOURCE_VERSION}).
      </p>
      <p>Trang tĩnh Astro SSG • Không Analytics • Không Cookie theo dõi • Không CDN bên thứ ba.</p>
    </div>
  </div>
</footer>
