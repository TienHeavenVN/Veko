---
import {
  ArrowRight,
  CodeXml,
  ShieldCheck,
  Smartphone,
  Cpu,
  Check,
  Sparkles,
} from '@lucide/astro';
import {
  HAS_OFFICIAL_RELEASE,
  OFFICIAL_RELEASE_VERSION,
  VEKO_LICENSE_SPDX,
  VEKO_MIN_ANDROID,
  VEKO_REPO_URL,
  VEKO_SOURCE_VERSION,
} from '../data/vekoData';
import { withBase } from '../utils/url';
---

<section
  aria-labelledby="hero-heading"
  class="veko-arch-grid relative overflow-hidden border-b border-veko-border/75 pt-10 pb-20 sm:pt-16 sm:pb-28 lg:pt-20"
>
  <!-- Ánh sáng chiều sâu quang học Navy / Cyan / Cobalt -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-44 left-1/2 h-[520px] w-[960px] -translate-x-1/2 rounded-full blur-3xl"
    style="background: radial-gradient(circle, var(--veko-hero-glow) 0%, transparent 68%);"
  >
  </div>

  <div class="relative mx-auto grid max-w-7xl items-center gap-14 px-4 sm:px-6 lg:grid-cols-12 lg:gap-12 lg:px-8">
    <!-- Cột thông điệp sản phẩm -->
    <div class="lg:col-span-7">
      <div class="inline-flex flex-wrap items-center gap-2 rounded-full border border-veko-border bg-veko-panel/90 px-3.5 py-1.5 text-xs font-semibold text-veko-muted shadow-xs">
        <span class="inline-flex items-center gap-1.5 font-mono font-bold text-veko-cyan">
          <Sparkles class="h-3.5 w-3.5" aria-hidden="true" />
          <span>Release {OFFICIAL_RELEASE_VERSION ?? 'dev'} • Source {VEKO_SOURCE_VERSION}</span>
        </span>
        <span aria-hidden="true" class="text-veko-border">•</span>
        <span>{VEKO_MIN_ANDROID}</span>
        <span aria-hidden="true" class="text-veko-border">•</span>
        <span>Giấy phép {VEKO_LICENSE_SPDX}</span>
      </div>

      <h1
        id="hero-heading"
        class="mt-6 text-balance text-4xl font-extrabold tracking-[-0.03em] text-veko-text sm:text-5xl lg:text-[3.6rem] lg:leading-[1.08]"
      >
        Trình duyệt gọn trong tầm tay.
        <span class="mt-1 block bg-gradient-to-r from-veko-cyan via-sky-400 to-blue-500 bg-clip-text text-transparent">
          Dữ liệu nằm trên máy bạn.
        </span>
      </h1>

      <p class="mt-6 max-w-2xl text-pretty text-base leading-relaxed text-veko-muted sm:text-lg">
        <strong class="font-semibold text-veko-text">Veko Browser</strong> được thiết kế cho thói quen sử dụng điện thoại một tay trên Android:
        nhân kết xuất thực <strong class="font-semibold text-veko-text">Mozilla GeckoView</strong> (Gecko + SpiderMonkey), thanh địa chỉ sát cạnh dưới, phiên riêng tư cô lập trên bộ nhớ RAM và lá chắn nội dung Rust qua C++20 JNI — không bảng tin rác, không telemetry ngầm.
      </p>

      <div class="mt-8 flex flex-col gap-3.5 sm:flex-row sm:items-center">
        <a
          href={`${withBase('/')}#tai-ung-dung`}
          class="veko-cta-primary veko-btn-interactive inline-flex items-center justify-center gap-2.5 rounded-xl px-6 py-3.5 text-sm font-bold"
        >
          <span>
            {HAS_OFFICIAL_RELEASE && OFFICIAL_RELEASE_VERSION
              ? `Tải APK ${OFFICIAL_RELEASE_VERSION} & Kiểm tra SHA-256`
              : 'Tải ứng dụng & Tự biên dịch'}
          </span>
          <ArrowRight class="h-4 w-4" aria-hidden="true" />
        </a>

        <a
          href={VEKO_REPO_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="veko-btn-interactive inline-flex items-center justify-center gap-2.5 rounded-xl border border-veko-border bg-veko-panel px-6 py-3.5 text-sm font-semibold text-veko-text hover:border-veko-cyan/60 hover:bg-veko-card-hover"
        >
          <CodeXml class="h-4 w-4 text-veko-cyan" aria-hidden="true" />
          <span>Khám phá mã nguồn GitHub</span>
        </a>
      </div>

      <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-veko-muted">
        <span class="inline-flex items-center gap-1.5">
          <Check class="h-3.5 w-3.5 text-veko-teal" aria-hidden="true" />
          <span>Không yêu cầu tài khoản</span>
        </span>
        <span class="inline-flex items-center gap-1.5">
          <Check class="h-3.5 w-3.5 text-veko-teal" aria-hidden="true" />
          <span>Không SDK phân tích hay quảng cáo</span>
        </span>
        <span class="inline-flex items-center gap-1.5">
          <Check class="h-3.5 w-3.5 text-veko-teal" aria-hidden="true" />
          <span>58 bài JUnit + 10 bài test Android 14 Emulator</span>
        </span>
      </div>

      <!-- Dải thông số kiến trúc thực tế -->
      <dl class="mt-10 grid grid-cols-1 gap-3.5 border-t border-veko-border/75 pt-7 sm:grid-cols-3">
        <div class="veko-cyber-card rounded-2xl border border-veko-border/80 bg-veko-panel/85 p-4">
          <div class="flex items-center gap-2 text-xs font-bold text-veko-cyan uppercase">
            <Smartphone class="h-4 w-4 shrink-0" aria-hidden="true" />
            <dt>Điều hướng một tay</dt>
          </div>
          <dd class="mt-1.5 text-xs leading-relaxed text-veko-muted">
            Thanh địa chỉ cạnh dưới, vuốt ngang đổi tab, vuốt lên mở lưới xem trước tab.
          </dd>
        </div>

        <div class="veko-cyber-card rounded-2xl border border-veko-border/80 bg-veko-panel/85 p-4">
          <div class="flex items-center gap-2 text-xs font-bold text-veko-teal uppercase">
            <ShieldCheck class="h-4 w-4 shrink-0" aria-hidden="true" />
            <dt>Rust FFI + ETP</dt>
          </div>
          <dd class="mt-1.5 text-xs leading-relaxed text-veko-muted">
            Lọc tên miền theo dõi qua <code>adblock-rust</code> và gọt tham số <code>utm_*</code>, <code>fbclid</code>.
          </dd>
        </div>

        <div class="veko-cyber-card rounded-2xl border border-veko-border/80 bg-veko-panel/85 p-4">
          <div class="flex items-center gap-2 text-xs font-bold text-veko-cobalt uppercase">
            <Cpu class="h-4 w-4 shrink-0" aria-hidden="true" />
            <dt>Trần 6 phiên LRU</dt>
          </div>
          <dd class="mt-1.5 text-xs leading-relaxed text-veko-muted">
            Giới hạn cứng <code>MAX_LIVE_SESSIONS = 6</code>, tự đóng băng và khôi phục tab lười.
          </dd>
        </div>
      </dl>
    </div>

    <!-- Cột sân khấu minh họa giao diện Android (phân biệt rõ UI Mockup SVG) -->
    <div class="relative flex justify-center lg:col-span-5">
      <div class="relative w-full max-w-[336px]">
        <div
          aria-hidden="true"
          class="pointer-events-none absolute -inset-5 rounded-[3rem] bg-gradient-to-tr from-veko-cyan/25 via-veko-cobalt/12 to-transparent blur-2xl"
        >
        </div>

        <figure class="relative rounded-[2.6rem] border-2 border-slate-700/80 bg-[#050A14] p-2.5 shadow-2xl">
          <div class="mb-2 flex items-center justify-between px-3 pt-0.5">
            <span class="h-1.5 w-12 rounded-full bg-slate-800" aria-hidden="true"></span>
            <span class="rounded-full border border-sky-400/35 bg-sky-500/12 px-2 py-0.5 font-mono text-[10px] font-semibold text-sky-300">
              UI Mockup • SVG
            </span>
          </div>
          <img
            src={withBase('/screenshots/veko-home-refactored.svg')}
            alt="Bản dựng minh họa SVG màn hình Trang chủ Veko Browser trên Android với header tinh gọn, thanh tìm kiếm trung tâm, 4 nút tác vụ nhanh và thanh điều hướng cạnh dưới"
            width="360"
            height="760"
            decoding="async"
            fetchpriority="high"
            class="mx-auto h-auto w-full rounded-[2rem]"
          />
          <figcaption class="mt-2 px-2 text-center font-mono text-[10px] text-slate-400">
            Bản dựng minh họa vector mô phỏng bố cục Jetpack Compose (không phải ảnh chụp máy thật).
          </figcaption>
        </figure>

        <!-- Thẻ nổi chỉ báo kỹ thuật (ẩn trên màn rất hẹp để không che giao diện) -->
        <div
          aria-hidden="true"
          class="hidden rounded-2xl border border-veko-border bg-veko-panel/95 px-3.5 py-2.5 shadow-xl backdrop-blur-md sm:block sm:absolute sm:-left-10 sm:top-16"
        >
          <p class="font-mono text-[10px] font-bold tracking-wider text-veko-teal uppercase">
            PRIVATE MODE • RAM
          </p>
          <p class="mt-0.5 text-xs font-semibold text-veko-text">
            Không ghi lịch sử SQLite ở tab Riêng tư
          </p>
        </div>

        <div
          aria-hidden="true"
          class="hidden rounded-2xl border border-veko-border bg-veko-panel/95 px-3.5 py-2.5 shadow-xl backdrop-blur-md sm:block sm:absolute sm:-right-8 sm:bottom-20"
        >
          <p class="font-mono text-[10px] font-bold tracking-wider text-veko-cyan uppercase">
            GECKOVIEW 150.0
          </p>
          <p class="mt-0.5 text-xs font-semibold text-veko-text">
            Gecko + SpiderMonkey mặc định
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
