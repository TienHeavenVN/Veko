---
import {
  Clock,
  Download,
  ExternalLink,
  Terminal,
  PackageCheck,
  Copy,
  Check,
  ShieldCheck,
  FileCheck,
} from '@lucide/astro';
import {
  APK_VARIANTS,
  HAS_OFFICIAL_RELEASE,
  OFFICIAL_RELEASE_ASSETS,
  OFFICIAL_RELEASE_VERSION,
  VEKO_ACTIONS_URL,
  VEKO_LATEST_CHECKSUMS_URL,
  VEKO_LATEST_RELEASE_URL,
  VEKO_MIN_ANDROID,
  VEKO_RELEASES_URL,
  VEKO_REPO_URL,
  VEKO_SOURCE_VERSION,
} from '../data/vekoData';
---

<section
  id="tai-ung-dung"
  aria-labelledby="download-heading"
  class="border-t border-veko-border/75 py-20 sm:py-28"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12">
      <!-- Cột trái: Trạng thái phát hành & kênh chính thức -->
      <div class="lg:col-span-6" data-reveal>
        {
          HAS_OFFICIAL_RELEASE && OFFICIAL_RELEASE_VERSION ? (
            <div class="inline-flex flex-wrap items-center gap-2 rounded-full border border-veko-emerald/45 bg-emerald-500/10 px-3.5 py-1 text-xs font-bold text-veko-emerald">
              <ShieldCheck class="h-3.5 w-3.5" aria-hidden="true" />
              <span>Bản phát hành chính thức đã ký số • {OFFICIAL_RELEASE_VERSION}</span>
            </div>
          ) : (
            <div class="inline-flex flex-wrap items-center gap-2 rounded-full border border-veko-amber/45 bg-amber-500/10 px-3.5 py-1 text-xs font-bold text-veko-amber">
              <Clock class="h-3.5 w-3.5" aria-hidden="true" />
              <span>Đang phát triển • Mã nguồn {VEKO_SOURCE_VERSION}</span>
            </div>
          )
        }

        <h2
          id="download-heading"
          class="mt-4 text-balance text-3xl font-extrabold tracking-[-0.025em] text-veko-text sm:text-4xl"
        >
          Tải ứng dụng &amp; Xác minh chữ ký minh bạch
        </h2>

        {
          HAS_OFFICIAL_RELEASE && OFFICIAL_RELEASE_VERSION ? (
            <div class="mt-4 space-y-4">
              <p class="text-pretty text-base leading-relaxed text-veko-muted">
                Phiên bản phát hành chính thức gần nhất <strong class="font-semibold text-veko-text">{OFFICIAL_RELEASE_VERSION}</strong> trên GitHub Releases được ký bằng khóa riêng và kiểm định qua <code>apksigner</code>. Kiến trúc tiếp theo <code class="font-mono text-xs text-veko-cyan">{VEKO_SOURCE_VERSION}</code> đang được kiểm thử trên GitHub Actions CI trước khi gắn thẻ mới (ứng dụng hiện chưa phát hành trên Google Play hay F-Droid):
              </p>

              <div class="space-y-3 pt-1">
                {OFFICIAL_RELEASE_ASSETS.map((asset) => (
                  <div class="veko-cyber-card rounded-2xl border border-veko-border bg-veko-panel p-4">
                    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                      <div>
                        <div class="flex flex-wrap items-center gap-2">
                          <span class="font-mono text-sm font-extrabold text-veko-text">
                            {asset.abi}
                          </span>
                          <span class="rounded-md border border-veko-border bg-veko-surface px-2 py-0.5 font-mono text-[11px] font-semibold text-veko-muted">
                            {asset.sizeLabel}
                          </span>
                          {asset.recommended && (
                            <span class="rounded-md bg-veko-cyan/15 px-2 py-0.5 text-[11px] font-bold text-veko-cyan">
                              Khuyên dùng
                            </span>
                          )}
                        </div>
                        <p class="mt-1 text-xs text-veko-muted">{asset.deviceHint}</p>
                        <p class="mt-1.5 break-all font-mono text-[11px] text-veko-muted/90">
                          SHA-256: {asset.sha256}
                        </p>
                      </div>

                      <a
                        href={asset.downloadUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class:list={[
                          'veko-btn-interactive inline-flex shrink-0 items-center justify-center gap-2 rounded-xl px-4 py-2.5 text-xs font-bold',
                          asset.recommended
                            ? 'veko-cta-primary'
                            : 'border border-veko-border bg-veko-surface text-veko-text hover:border-veko-cyan/60',
                        ]}
                      >
                        <Download class="h-4 w-4" aria-hidden="true" />
                        <span>Tải {asset.filename}</span>
                      </a>
                    </div>
                  </div>
                ))}
              </div>

              <div class="flex flex-wrap gap-3 pt-1">
                <a
                  href={VEKO_LATEST_RELEASE_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="veko-btn-interactive inline-flex items-center gap-2 rounded-xl border border-veko-border bg-veko-panel px-4 py-2.5 text-xs font-semibold text-veko-text hover:border-veko-cyan/60 hover:bg-veko-card-hover"
                >
                  <span>Trang phát hành {OFFICIAL_RELEASE_VERSION}</span>
                  <ExternalLink class="h-3.5 w-3.5 text-veko-cyan" aria-hidden="true" />
                </a>
                <a
                  href={VEKO_LATEST_CHECKSUMS_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="veko-btn-interactive inline-flex items-center gap-2 rounded-xl border border-veko-border bg-veko-panel px-4 py-2.5 text-xs font-semibold text-veko-text hover:border-veko-cyan/60 hover:bg-veko-card-hover"
                >
                  <FileCheck class="h-3.5 w-3.5 text-veko-emerald" aria-hidden="true" />
                  <span>Tệp SHA256SUMS.txt</span>
                </a>
                <a
                  href={VEKO_ACTIONS_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="veko-btn-interactive inline-flex items-center gap-2 rounded-xl border border-veko-border bg-veko-panel px-4 py-2.5 text-xs font-semibold text-veko-text hover:border-veko-cyan/60 hover:bg-veko-card-hover"
                >
                  <span>Bản dựng CI ({VEKO_SOURCE_VERSION})</span>
                  <ExternalLink class="h-3.5 w-3.5 text-veko-cyan" aria-hidden="true" />
                </a>
              </div>
            </div>
          ) : (
            <div class="mt-4 space-y-4">
              <p class="text-pretty text-base leading-relaxed text-veko-muted">
                Veko Browser hiện đang được phát triển trên nhánh mã nguồn <code class="font-mono text-xs text-veko-cyan">{VEKO_SOURCE_VERSION}</code> và <strong class="font-semibold text-veko-text">chưa công bố bản phát hành chính thức</strong> trên GitHub Releases (cũng chưa phát hành trên Google Play hay F-Droid).
              </p>

              <div class="rounded-2xl border border-veko-border bg-veko-panel p-4 text-xs leading-relaxed text-veko-muted">
                <div class="flex items-center gap-2 font-bold text-veko-text">
                  <ShieldCheck class="h-4 w-4 text-veko-teal" aria-hidden="true" />
                  <span>Cam kết không phát tán liên kết APK không rõ nguồn gốc</span>
                </div>
                <p class="mt-1.5">
                  Bản <code>release</code> chính thức bị khóa cứng bởi tác vụ <code>verifyReleaseSigningConfig</code> và chỉ xuất bản tự động kèm tệp kiểm tra <code>SHA256SUMS.txt</code> khi gắn thẻ <code>v*</code>.
                </p>
              </div>

              <div class="flex flex-wrap gap-3 pt-2">
                <a
                  href={VEKO_RELEASES_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="veko-cta-primary veko-btn-interactive inline-flex items-center gap-2 rounded-xl px-5 py-3 text-sm font-bold"
                >
                  <span>Theo dõi GitHub Releases</span>
                  <ExternalLink class="h-4 w-4" aria-hidden="true" />
                </a>
                <a
                  href={VEKO_ACTIONS_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="veko-btn-interactive inline-flex items-center gap-2 rounded-xl border border-veko-border bg-veko-panel px-5 py-3 text-sm font-semibold text-veko-text hover:border-veko-cyan/60 hover:bg-veko-card-hover"
                >
                  <span>Xem bản dựng CI Preview</span>
                  <ExternalLink class="h-4 w-4 text-veko-cyan" aria-hidden="true" />
                </a>
                <a
                  href={VEKO_REPO_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="veko-btn-interactive inline-flex items-center gap-2 rounded-xl border border-veko-border bg-veko-panel px-5 py-3 text-sm font-semibold text-veko-text hover:border-veko-cyan/60 hover:bg-veko-card-hover"
                >
                  <span>Mã nguồn dự án</span>
                  <ExternalLink class="h-4 w-4 text-veko-cyan" aria-hidden="true" />
                </a>
              </div>
            </div>
          )
        }
      </div>

      <!-- Cột phải: Terminal tự biên dịch khớp thực tế 7-module Gradle + Cargo + Android NDK -->
      <div class="lg:col-span-6" data-reveal>
        <div class="veko-cyber-card rounded-3xl border border-veko-border bg-veko-panel p-6 sm:p-7">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="flex items-center gap-2.5 text-sm font-extrabold text-veko-text">
              <Terminal class="h-4 w-4 text-veko-cyan" aria-hidden="true" />
              <h3>Tự biên dịch từ mã nguồn ({VEKO_MIN_ANDROID})</h3>
            </div>
            <button
              type="button"
              id="copy-build-cmd"
              aria-label="Sao chép lệnh biên dịch Veko Browser"
              class="veko-btn-interactive inline-flex items-center gap-1.5 rounded-lg border border-veko-border bg-veko-surface px-3 py-1.5 text-xs font-semibold text-veko-muted hover:border-veko-cyan/60 hover:text-veko-text"
            >
              <Copy id="copy-icon-default" class="h-3.5 w-3.5 text-veko-cyan" aria-hidden="true" />
              <Check id="copy-icon-done" class="hidden h-3.5 w-3.5 text-veko-teal" aria-hidden="true" />
              <span id="copy-cmd-label">Sao chép lệnh</span>
            </button>
          </div>

          <p class="mt-2.5 text-xs leading-relaxed text-veko-muted">
            Yêu cầu khớp <code>build.gradle.kts</code> &amp; <code>scripts/setup-native-toolchains.sh</code>: <strong>JDK 17</strong>, <strong>Android SDK 37 / NDK 27.2+</strong> và <strong>Rust &ge; 1.86</strong>.
          </p>

          <pre
            id="veko-build-snippet"
            class="mt-4 overflow-x-auto rounded-2xl border border-slate-700/80 bg-[#050A14] p-4 font-mono text-xs leading-relaxed text-[#EAF1FB]"
          ><code>git clone https://github.com/TienHeavenVN/Veko.git
cd Veko
bash scripts/setup-native-toolchains.sh --with-android
./gradlew test lintDebug
./gradlew :app:assemblePreview</code></pre>

          <p class="mt-3.5 text-xs leading-relaxed text-veko-muted">
            Tác vụ <code>:app:assemblePreview</code> tự động kích hoạt <code>:privacy:buildAndroidAdblockNative</code> (biên dịch Rust <code>adblock-rust</code> + C++20 JNI <code>libveko_adblock_jni.so</code> căn lề 16 KB ELF) và xuất 3 gói ABI tại <code>app/build/outputs/apk/preview/</code> với định danh độc lập <code>io.veko.browser.preview</code>.
          </p>
        </div>
      </div>
    </div>

    <!-- Bảng phân biệt 3 biến thể APK -->
    <div
      data-reveal
      class="mt-12 overflow-hidden rounded-3xl border border-veko-border bg-veko-panel"
    >
      <div class="flex items-center gap-2.5 border-b border-veko-border px-6 py-4 sm:px-7">
        <PackageCheck class="h-5 w-5 text-veko-cyan" aria-hidden="true" />
        <h3 class="text-base font-extrabold text-veko-text">
          Cơ chế tách biệt 3 biến thể APK trong module :app
        </h3>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-veko-border/80 bg-veko-surface text-xs text-veko-muted uppercase">
            <tr>
              <th scope="col" class="px-6 py-3.5 font-bold">Biến thể</th>
              <th scope="col" class="px-6 py-3.5 font-bold">Package ID</th>
              <th scope="col" class="px-6 py-3.5 font-bold">Chữ ký &amp; Tối ưu hóa</th>
              <th scope="col" class="px-6 py-3.5 font-bold">Trạng thái cung cấp</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-veko-border/60">
            {
              APK_VARIANTS.map((variant) => (
                <tr class="transition-colors hover:bg-veko-card/40">
                  <td class="px-6 py-4 font-bold text-veko-text">{variant.name}</td>
                  <td class="px-6 py-4 font-mono text-xs font-semibold text-veko-cyan">{variant.packageId}</td>
                  <td class="px-6 py-4 text-veko-muted">{variant.signingAndOptimization}</td>
                  <td class="px-6 py-4 text-veko-muted">{variant.availability}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-build-cmd');
  const snippet = document.getElementById('veko-build-snippet');
  const iconDefault = document.getElementById('copy-icon-default');
  const iconDone = document.getElementById('copy-icon-done');
  const label = document.getElementById('copy-cmd-label');

  copyBtn?.addEventListener('click', async () => {
    const raw = snippet?.textContent?.trim();
    if (!raw || !navigator.clipboard) return;
    try {
      await navigator.clipboard.writeText(raw);
      iconDefault?.classList.add('hidden');
      iconDone?.classList.remove('hidden');
      if (label) label.textContent = 'Đã sao chép';
      window.setTimeout(() => {
        iconDefault?.classList.remove('hidden');
        iconDone?.classList.add('hidden');
        if (label) label.textContent = 'Sao chép lệnh';
      }, 2000);
    } catch (_err) {
      // Bỏ qua nếu quyền clipboard bị giới hạn
    }
  });
</script>
