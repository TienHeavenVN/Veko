---
import { Clock, ExternalLink, Terminal, PackageCheck } from '@lucide/astro';
import {
  APK_VARIANTS,
  HAS_OFFICIAL_RELEASE,
  OFFICIAL_RELEASE_VERSION,
  VEKO_ACTIONS_URL,
  VEKO_RELEASES_URL,
  VEKO_REPO_URL,
} from '../data/vekoData';
---

<section
  id="tai-ung-dung"
  aria-labelledby="download-heading"
  class="border-t border-veko-border/60 bg-veko-surface/80 py-20 sm:py-24"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <div class="inline-flex items-center gap-2 rounded-full border border-amber-400/40 bg-amber-500/10 px-3.5 py-1 text-xs font-bold text-amber-300">
          <Clock class="h-3.5 w-3.5" aria-hidden="true" />
          <span>
            {HAS_OFFICIAL_RELEASE && OFFICIAL_RELEASE_VERSION
              ? `Bản phát hành hiện tại: ${OFFICIAL_RELEASE_VERSION}`
              : 'Trạng thái: Đang phát triển'}
          </span>
        </div>

        <h2 id="download-heading" class="mt-4 text-3xl font-extrabold tracking-tight text-veko-text sm:text-4xl">
          Tải ứng dụng &amp; Bắt đầu sử dụng
        </h2>

        {
          HAS_OFFICIAL_RELEASE && OFFICIAL_RELEASE_VERSION ? (
            <div class="mt-4 space-y-4">
              <p class="text-base leading-relaxed text-veko-muted">
                Tải gói APK chính thức đã ký khóa phát hành và kiểm tra mã băm SHA-256 trực tiếp trên kênh GitHub Releases của dự án.
              </p>
              <a
                href={VEKO_RELEASES_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-xl bg-veko-cyan px-6 py-3.5 text-sm font-bold text-slate-950"
              >
                <span>Tải APK trên GitHub Releases</span>
                <ExternalLink class="h-4 w-4" aria-hidden="true" />
              </a>
            </div>
          ) : (
            <div class="mt-4 space-y-4">
              <p class="text-base leading-relaxed text-veko-muted">
                Veko Browser hiện đang trong giai đoạn phát triển tích cực và <strong class="font-semibold text-veko-text">chưa công bố bản phát hành chính thức</strong> trên GitHub Releases (chưa phát hành trên cửa hàng ứng dụng bên thứ ba).
              </p>
              <p class="text-sm leading-relaxed text-veko-muted">
                Bạn có thể theo dõi trang Releases để nhận thông báo khi có bản chính thức đầu tiên, kiểm tra các gói thử nghiệm tự động trên GitHub Actions, hoặc tự biên dịch trực tiếp từ mã nguồn.
              </p>
              <div class="flex flex-wrap gap-3 pt-2">
                <a
                  href={VEKO_REPO_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 rounded-xl bg-veko-cyan px-5 py-3 text-sm font-bold text-slate-950 transition-opacity hover:opacity-95"
                >
                  <span>Mở Repository dự án</span>
                  <ExternalLink class="h-4 w-4" aria-hidden="true" />
                </a>
                <a
                  href={VEKO_RELEASES_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 rounded-xl border border-veko-border bg-veko-card px-5 py-3 text-sm font-semibold text-veko-text transition-colors hover:border-veko-cyan/60"
                >
                  <span>Trang GitHub Releases</span>
                  <ExternalLink class="h-4 w-4 text-veko-cyan" aria-hidden="true" />
                </a>
                <a
                  href={VEKO_ACTIONS_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 rounded-xl border border-veko-border bg-veko-card px-5 py-3 text-sm font-semibold text-veko-text transition-colors hover:border-veko-cyan/60"
                >
                  <span>Quy trình CI Build APK</span>
                  <ExternalLink class="h-4 w-4 text-veko-cyan" aria-hidden="true" />
                </a>
              </div>
            </div>
          )
        }
      </div>

      <!-- Hướng dẫn bắt đầu sử dụng từ mã nguồn -->
      <div class="lg:col-span-6">
        <div class="rounded-2xl border border-veko-border bg-veko-panel p-6">
          <div class="flex items-center gap-2.5 text-sm font-bold text-veko-text">
            <Terminal class="h-4 w-4 text-veko-cyan" aria-hidden="true" />
            <h3>Hướng dẫn tự biên dịch &amp; chạy thử (Android 8.0+ / API 26+)</h3>
          </div>
          <ol class="mt-4 space-y-3 text-sm text-veko-muted">
            <li>
              <span class="font-semibold text-veko-text">1. Chuẩn bị môi trường:</span> JDK 17, Android SDK/NDK, Rust (&ge; 1.85), GN và Ninja.
            </li>
            <li>
              <span class="font-semibold text-veko-text">2. Sao chép kho mã nguồn &amp; chạy kiểm thử:</span>
            </li>
          </ol>
          <pre
            class="mt-3 overflow-x-auto rounded-xl border border-veko-border/80 bg-veko-bg p-4 font-mono text-xs leading-relaxed text-veko-text"
          ><code>git clone https://github.com/TienHeavenVN/Zeko.git
cd Zeko
./gradlew :app:testDebugUnitTest :app:lintDebug
./gradlew :app:assembleDebug</code></pre>
          <p class="mt-3 text-xs leading-relaxed text-veko-muted">
            Gói <code>app-arm64-v8a-debug.apk</code> xuất ra tại <code>app/build/outputs/apk/debug/</code> có thể cài đặt song song dưới định danh <code>io.veko.browser.debug</code> mà không ảnh hưởng dữ liệu các ứng dụng khác.
          </p>
        </div>
      </div>
    </div>

    <!-- Bảng phân biệt 3 biến thể APK thực tế trong mã nguồn -->
    <div class="mt-12 overflow-hidden rounded-2xl border border-veko-border bg-veko-panel">
      <div class="flex items-center gap-2 border-b border-veko-border px-6 py-4">
        <PackageCheck class="h-5 w-5 text-veko-cyan" aria-hidden="true" />
        <h3 class="text-base font-bold text-veko-text">
          Cơ chế tách biệt 3 biến thể APK của Veko Browser
        </h3>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-veko-border/70 bg-veko-card/60 text-xs text-veko-muted uppercase">
            <tr>
              <th scope="col" class="px-6 py-3.5 font-semibold">Biến thể</th>
              <th scope="col" class="px-6 py-3.5 font-semibold">Package ID</th>
              <th scope="col" class="px-6 py-3.5 font-semibold">Chữ ký &amp; Tối ưu</th>
              <th scope="col" class="px-6 py-3.5 font-semibold">Trạng thái cung cấp</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-veko-border/50">
            {
              APK_VARIANTS.map((variant) => (
                <tr>
                  <td class="px-6 py-4 font-semibold text-veko-text">{variant.name}</td>
                  <td class="px-6 py-4 font-mono text-xs text-veko-cyan">{variant.packageId}</td>
                  <td class="px-6 py-4 text-veko-muted">{variant.signingAndOptimization}</td>
                  <td class="px-6 py-4 text-veko-muted">{variant.availability}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
