---
import {
  Check,
  Search,
  Layers,
  EyeOff,
  Shield,
  SlidersHorizontal,
  Lock,
  Camera,
  Mic,
  MapPin,
} from '@lucide/astro';
import { SHOWCASE_TABS } from '../data/vekoData';
---

<section
  id="trai-nghiem"
  aria-labelledby="showcase-heading"
  class="border-b border-veko-border/70 bg-veko-surface/65 py-20 sm:py-28"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8" data-reveal>
    <div class="max-w-3xl">
      <p class="font-mono text-xs font-bold tracking-widest text-veko-cyan uppercase">
        Product Showcase • Tương tác thực tế
      </p>
      <h2
        id="showcase-heading"
        class="mt-2.5 text-balance text-3xl font-extrabold tracking-[-0.025em] text-veko-text sm:text-4xl"
      >
        Khám phá 5 luồng thao tác cốt lõi bên trong Veko Browser
      </h2>
      <p class="mt-3 text-pretty text-base leading-relaxed text-veko-muted">
        Chọn từng chế độ bên dưới (hỗ trợ phím mũi tên Trái/Phải và Home/End) để xem cách Veko tổ chức thanh địa chỉ, khay lưới tab, phiên duyệt riêng tư, lá chắn nội dung và quyền truy cập theo từng trang web.
      </p>
    </div>

    <!-- Thanh chuyển chế độ (Accessible Tablist, hỗ trợ phím mũi tên Trái/Phải/Home/End) -->
    <div
      role="tablist"
      aria-label="Các màn hình chức năng của Veko Browser"
      class="mt-9 flex gap-2 overflow-x-auto pb-2"
    >
      {
        SHOWCASE_TABS.map((tab, index) => (
          <button
            type="button"
            role="tab"
            id={`showcase-tab-${tab.id}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={`showcase-panel-${tab.id}`}
            tabindex={index === 0 ? 0 : -1}
            data-showcase-tab={tab.id}
            class:list={[
              'showcase-tab-btn veko-btn-interactive inline-flex shrink-0 items-center gap-2 rounded-xl border px-4 py-2.5 text-sm font-semibold',
              index === 0
                ? 'border-veko-cyan bg-veko-cyan/15 text-veko-text shadow-xs'
                : 'border-veko-border bg-veko-panel text-veko-muted hover:border-veko-cyan/50 hover:text-veko-text',
            ]}
          >
            {tab.id === 'address-bar' && <Search class="h-4 w-4 text-veko-cyan" aria-hidden="true" />}
            {tab.id === 'tab-management' && <Layers class="h-4 w-4 text-veko-cyan" aria-hidden="true" />}
            {tab.id === 'private-mode' && <EyeOff class="h-4 w-4 text-veko-cyan" aria-hidden="true" />}
            {tab.id === 'privacy-shield' && <Shield class="h-4 w-4 text-veko-cyan" aria-hidden="true" />}
            {tab.id === 'site-settings' && <SlidersHorizontal class="h-4 w-4 text-veko-cyan" aria-hidden="true" />}
            <span>{tab.shortLabel}</span>
          </button>
        ))
      }
    </div>

    <!-- Các Panel nội dung tương ứng -->
    <div class="mt-8">
      {
        SHOWCASE_TABS.map((tab, index) => (
          <div
            role="tabpanel"
            id={`showcase-panel-${tab.id}`}
            aria-labelledby={`showcase-tab-${tab.id}`}
            data-showcase-panel={tab.id}
            class:list={[
              'veko-cyber-card grid grid-cols-1 items-center gap-8 rounded-3xl border border-veko-border bg-veko-panel p-6 shadow-sm sm:p-8 lg:grid-cols-12 lg:gap-10 lg:p-10',
              index !== 0 && 'hidden',
            ]}
          >
            <!-- Mô tả kiến trúc & điểm nhấn -->
            <div class="lg:col-span-6">
              <span class="inline-block rounded-md bg-veko-cyan/12 px-2.5 py-1 font-mono text-xs font-bold text-veko-cyan">
                {tab.badge}
              </span>
              <h3 class="mt-4 text-balance text-2xl font-extrabold tracking-tight text-veko-text sm:text-[1.7rem] sm:leading-snug">
                {tab.title}
              </h3>
              <p class="mt-3 text-pretty text-sm leading-relaxed text-veko-muted sm:text-base">
                {tab.summary}
              </p>

              <ul class="mt-6 space-y-3">
                {tab.bullets.map((bullet) => (
                  <li class="flex items-start gap-2.5 text-sm leading-relaxed text-veko-text/90">
                    <Check class="mt-0.5 h-4 w-4 shrink-0 text-veko-teal" aria-hidden="true" />
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>

              <div class="mt-7 inline-flex items-center gap-2 rounded-xl border border-veko-border bg-veko-surface px-3.5 py-2 font-mono text-xs text-veko-muted">
                <span class="h-2 w-2 rounded-full bg-veko-cyan" aria-hidden="true" />
                <span>Module thực thi: <strong class="text-veko-text">{tab.modulePath}</strong></span>
              </div>
            </div>

            <!-- Sơ đồ trực quan hóa luồng dữ liệu UI (UI Diagram) -->
            <div class="lg:col-span-6">
              <div class="mx-auto max-w-md rounded-2xl border border-slate-700/80 bg-[#070E1A] p-5 text-[#EAF1FB] shadow-xl">
                {tab.id === 'address-bar' && (
                  <div class="space-y-4">
                    <div class="flex items-center justify-between text-xs text-[#98ABC8]">
                      <span class="font-mono font-semibold text-[#38BDF8]">AddressSearchSection.kt</span>
                      <span>Sơ đồ luồng nhập liệu</span>
                    </div>

                    <div class="rounded-2xl border border-[#38BDF8]/70 bg-[#0E1A2F] p-3.5">
                      <div class="flex items-center justify-between gap-2">
                        <span class="truncate font-mono text-xs text-[#EAF1FB]">
                          https://developer.android.com/jetpack/compose
                        </span>
                        <span class="shrink-0 rounded-full bg-[#182B49] px-2 py-0.5 text-[11px] text-[#98ABC8]">
                          Xóa ×
                        </span>
                      </div>
                      <div class="mt-3 flex flex-wrap items-center gap-2">
                        <span class="rounded-full border border-[#38BDF8]/50 bg-[#081120] px-2.5 py-1 text-[11px] font-semibold text-[#38BDF8]">
                          DuckDuckGo ▾
                        </span>
                        <span class="rounded-full border border-[#243B61] bg-[#081120] px-2.5 py-1 text-[11px] text-[#98ABC8]">
                          Brave Search
                        </span>
                        <span class="rounded-full border border-[#243B61] bg-[#081120] px-2.5 py-1 text-[11px] text-[#98ABC8]">
                          Dán &amp; đi
                        </span>
                      </div>
                    </div>

                    <div class="rounded-xl border border-[#1E3354] bg-[#0B1526] p-3 text-xs">
                      <p class="font-semibold text-[#EAF1FB]">Gợi ý tức thì từ Dấu trang cục bộ</p>
                      <p class="mt-1 font-mono text-[11px] text-[#98ABC8]">
                        developer.android.com • Không gửi ký tự gõ dở lên máy chủ Veko
                      </p>
                    </div>

                    <div class="flex items-center justify-between rounded-2xl border border-[#263F66] bg-[#0E1B31] px-3.5 py-2.5 text-xs">
                      <span class="rounded-lg bg-[#172A47] px-2 py-1 text-[11px]">Trang chủ</span>
                      <span class="font-mono text-[11px] text-[#38BDF8]">← Vuốt ngang đổi tab →</span>
                      <span class="rounded-lg bg-[#38BDF8]/20 px-2 py-1 font-mono font-bold text-[#38BDF8]">4</span>
                    </div>
                  </div>
                )}

                {tab.id === 'tab-management' && (
                  <div class="space-y-4">
                    <div class="flex items-center justify-between">
                      <div class="inline-flex rounded-full border border-[#243B61] bg-[#0B1526] p-1 text-xs">
                        <span class="rounded-full bg-[#172B49] px-3 py-1 font-bold text-[#EAF1FB]">Tab thường (5)</span>
                        <span class="px-3 py-1 text-[#98ABC8]">Riêng tư (1)</span>
                      </div>
                      <span class="font-mono text-[11px] font-bold text-[#2DD4BF]">LRU 6/6 MAX</span>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                      <div class="rounded-xl border-2 border-[#38BDF8] bg-[#10203A] p-3">
                        <div class="flex items-center justify-between text-xs font-bold">
                          <span class="truncate">Kotlin Docs</span>
                          <span class="text-[#98ABC8]">×</span>
                        </div>
                        <div class="mt-2 h-16 rounded-lg bg-[#081120] p-2 font-mono text-[10px] text-[#38BDF8]">
                          GeckoView • ACTIVE
                        </div>
                      </div>

                      <div class="rounded-xl border border-[#243B61] bg-[#0D192E] p-3">
                        <div class="flex items-center justify-between text-xs font-bold">
                          <span class="truncate">Mozilla Blog</span>
                          <span class="text-[#98ABC8]">×</span>
                        </div>
                        <div class="mt-2 h-16 rounded-lg bg-[#081120] p-2 font-mono text-[10px] text-[#98ABC8]">
                          setActive(false)
                        </div>
                      </div>

                      <div class="col-span-2 flex items-center justify-between rounded-xl border border-dashed border-[#2B4672] bg-[#0B1526] p-3">
                        <div>
                          <p class="text-xs font-bold text-[#EAF1FB]">Tab cũ vượt ngưỡng 6 phiên sống</p>
                          <p class="mt-0.5 text-[11px] text-[#98ABC8]">Giải phóng engine nền, giữ nguyên URL &amp; nhân đã gán để khôi phục lười</p>
                        </div>
                        <span class="shrink-0 rounded-md bg-[#2DD4BF]/15 px-2 py-1 font-mono text-[10px] font-bold text-[#2DD4BF]">
                          LAZY RESTORE
                        </span>
                      </div>
                    </div>
                  </div>
                )}

                {tab.id === 'private-mode' && (
                  <div class="space-y-4">
                    <div class="flex items-center justify-between rounded-xl border border-teal-400/40 bg-teal-500/10 px-3.5 py-2.5">
                      <span class="text-xs font-bold text-[#2DD4BF]">Chế độ Riêng tư đang bật</span>
                      <span class="font-mono text-[11px] text-[#EAF1FB]">usePrivateMode(true)</span>
                    </div>

                    <div class="grid grid-cols-2 gap-2.5 text-xs">
                      <div class="rounded-xl border border-[#1E3354] bg-[#0B1526] p-3">
                        <p class="font-mono text-[10px] text-[#2DD4BF]">ROOM SQLITE</p>
                        <p class="mt-1 font-bold">Không ghi lịch sử xuống đĩa</p>
                      </div>
                      <div class="rounded-xl border border-[#1E3354] bg-[#0B1526] p-3">
                        <p class="font-mono text-[10px] text-[#38BDF8]">DATASTORE</p>
                        <p class="mt-1 font-bold">Loại trừ phiên tab riêng tư</p>
                      </div>
                    </div>

                    <div class="rounded-xl border border-amber-400/35 bg-amber-500/10 p-3 text-[11px] leading-relaxed text-amber-100">
                      <strong class="font-bold text-amber-300">Lưu ý trung thực trong ứng dụng:</strong> Tab Riêng tư không lưu lịch sử trên điện thoại này, nhưng không ẩn địa chỉ IP trước nhà cung cấp Internet (ISP) hoặc trang web bạn truy cập.
                    </div>
                  </div>
                )}

                {tab.id === 'privacy-shield' && (
                  <div class="space-y-3.5">
                    <div class="flex items-center justify-between">
                      <span class="text-xs font-bold text-[#EAF1FB]">Lá chắn nội dung Rust FFI</span>
                      <span class="rounded-full bg-emerald-500/15 px-2.5 py-0.5 font-mono text-[10px] font-bold text-emerald-300">
                        adblock-rust 0.13.4
                      </span>
                    </div>

                    <div class="rounded-xl border border-[#1E3354] bg-[#081120] p-3 font-mono text-[11px]">
                      <p class="text-[#98ABC8] line-through">
                        https://news.example/post?id=42<span class="text-rose-400">&amp;utm_source=ads&amp;fbclid=IwAR9x</span>
                      </p>
                      <p class="mt-1.5 font-bold text-[#2DD4BF]">
                        → https://news.example/post?id=42
                      </p>
                    </div>

                    <div class="grid grid-cols-3 gap-2 text-center">
                      <div class="rounded-xl border border-[#243B61] bg-[#0D192E] p-2.5">
                        <p class="font-mono text-base font-extrabold text-[#38BDF8]">ETP</p>
                        <p class="mt-0.5 text-[10px] text-[#98ABC8]">Chặn Tracker</p>
                      </div>
                      <div class="rounded-xl border border-[#243B61] bg-[#0D192E] p-2.5">
                        <p class="font-mono text-base font-extrabold text-[#2DD4BF]">URL</p>
                        <p class="mt-0.5 text-[10px] text-[#98ABC8]">Gọt tham số</p>
                      </div>
                      <div class="rounded-xl border border-[#243B61] bg-[#0D192E] p-2.5">
                        <p class="font-mono text-base font-extrabold text-[#60A5FA]">dFPI</p>
                        <p class="mt-0.5 text-[10px] text-[#98ABC8]">Cô lập Cookie</p>
                      </div>
                    </div>
                  </div>
                )}

                {tab.id === 'site-settings' && (
                  <div class="space-y-3">
                    <div class="flex items-center justify-between gap-2 rounded-xl border border-[#243B61] bg-[#0B1526] px-3.5 py-2.5">
                      <span class="inline-flex items-center gap-2">
                        <Lock class="h-4 w-4 text-[#2DD4BF]" aria-hidden="true" />
                        <span class="font-mono text-xs font-bold text-[#EAF1FB]">https://meet.example.org:443</span>
                      </span>
                      <span class="rounded bg-[#172B49] px-2 py-0.5 font-mono text-[10px] text-[#38BDF8]">Gecko</span>
                    </div>

                    <div class="space-y-2 text-xs">
                      <div class="flex items-center justify-between rounded-xl border border-[#1E3354] bg-[#0D192E] px-3.5 py-2.5">
                        <span class="inline-flex items-center gap-2">
                          <Camera class="h-4 w-4 text-[#38BDF8]" aria-hidden="true" />
                          <span>Máy ảnh (Camera)</span>
                        </span>
                        <span class="rounded-md bg-[#38BDF8]/15 px-2 py-0.5 font-mono text-[11px] text-[#38BDF8]">Hỏi mỗi lần</span>
                      </div>
                      <div class="flex items-center justify-between rounded-xl border border-[#1E3354] bg-[#0D192E] px-3.5 py-2.5">
                        <span class="inline-flex items-center gap-2">
                          <Mic class="h-4 w-4 text-[#38BDF8]" aria-hidden="true" />
                          <span>Micrô (Microphone)</span>
                        </span>
                        <span class="rounded-md bg-rose-500/15 px-2 py-0.5 font-mono text-[11px] text-rose-300">Đã chặn</span>
                      </div>
                      <div class="flex items-center justify-between rounded-xl border border-[#1E3354] bg-[#0D192E] px-3.5 py-2.5">
                        <span class="inline-flex items-center gap-2">
                          <MapPin class="h-4 w-4 text-[#38BDF8]" aria-hidden="true" />
                          <span>Vị trí (Location)</span>
                        </span>
                        <span class="rounded-md bg-rose-500/15 px-2 py-0.5 font-mono text-[11px] text-rose-300">Đã chặn</span>
                      </div>
                    </div>
                  </div>
                )}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-showcase-tab]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-showcase-panel]'));

  function activateShowcaseTab(targetId: string, focusButton = false) {
    tabs.forEach((btn) => {
      const isSelected = btn.dataset.showcaseTab === targetId;
      btn.setAttribute('aria-selected', String(isSelected));
      btn.tabIndex = isSelected ? 0 : -1;

      btn.classList.toggle('border-veko-cyan', isSelected);
      btn.classList.toggle('bg-veko-cyan/15', isSelected);
      btn.classList.toggle('text-veko-text', isSelected);
      btn.classList.toggle('shadow-xs', isSelected);

      btn.classList.toggle('border-veko-border', !isSelected);
      btn.classList.toggle('bg-veko-panel', !isSelected);
      btn.classList.toggle('text-veko-muted', !isSelected);

      if (isSelected && focusButton) {
        btn.focus();
      }
    });

    panels.forEach((panel) => {
      panel.classList.toggle('hidden', panel.dataset.showcasePanel !== targetId);
    });
  }

  tabs.forEach((btn, idx) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.showcaseTab;
      if (id) activateShowcaseTab(id, false);
    });

    btn.addEventListener('keydown', (event) => {
      let nextIndex: number | null = null;
      if (event.key === 'ArrowRight') nextIndex = (idx + 1) % tabs.length;
      else if (event.key === 'ArrowLeft') nextIndex = (idx - 1 + tabs.length) % tabs.length;
      else if (event.key === 'Home') nextIndex = 0;
      else if (event.key === 'End') nextIndex = tabs.length - 1;

      if (nextIndex !== null) {
        event.preventDefault();
        const targetId = tabs[nextIndex]?.dataset.showcaseTab;
        if (targetId) activateShowcaseTab(targetId, true);
      }
    });
  });
</script>
