---
interface Props {
  size?: number;
  class?: string;
}

const { size = 36, class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 64 64"
  width={size}
  height={size}
  aria-hidden="true"
  class:list={['shrink-0 select-none', className]}
>
  <defs>
    <linearGradient id="vekoNavLogoGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1D4ED8" />
      <stop offset="100%" stop-color="#06B6D4" />
    </linearGradient>
  </defs>
  <rect x="2" y="2" width="60" height="60" rx="18" fill="url(#vekoNavLogoGrad)" />
  <path
    d="M18.5 20.5 L32 46.5 L45.5 20.5"
    fill="none"
    stroke="#FFFFFF"
    stroke-width="6.8"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <circle cx="32" cy="22" r="3.6" fill="#A5F3FC" />
</svg>
