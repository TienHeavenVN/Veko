---
import VekoLogo from './VekoLogo.astro';
import { Menu, X, Download, CodeXml, Sun, Moon } from '@lucide/astro';
import { MAIN_NAV_ITEMS, VEKO_REPO_URL } from '../data/vekoData';
import { withBase } from '../utils/url';

const homeBase = withBase('/');
const downloadHref = `${homeBase}#tai-ung-dung`;
---

<header class="sticky top-0 z-40 border-b border-veko-border/75 bg-veko-bg/82 backdrop-blur-xl">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
    <div class="flex items-center gap-3">
      <a
        href={homeBase}
        class="flex items-center gap-2.5 rounded-xl py-1 pr-1.5 transition-opacity hover:opacity-90"
        aria-label="Trang chủ Veko Browser"
      >
        <VekoLogo size={34} />
        <span class="text-lg font-extrabold tracking-tight text-veko-text">
          Veko
        </span>
      </a>
      <span
        class="hidden rounded-full border border-veko-border bg-veko-panel px-2.5 py-0.5 font-mono text-[11px] font-semibold text-veko-cyan sm:inline-block"
      >
        Android • v0.2.0
      </span>
    </div>

    <nav aria-label="Điều hướng chính" class="hidden items-center gap-1 lg:flex">
      {
        MAIN_NAV_ITEMS.map((item) => (
          <a
            href={`${homeBase}${item.anchor}`}
            class="rounded-lg px-3 py-2 text-sm font-medium text-veko-muted transition-colors hover:bg-veko-card/70 hover:text-veko-text"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-2.5 md:flex">
      <button
        type="button"
        data-theme-toggle
        aria-label="Chuyển đổi giao diện Sáng hoặc Tối"
        title="Đổi giao diện Sáng / Tối"
        class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-veko-border bg-veko-panel text-veko-muted transition-colors hover:border-veko-cyan/60 hover:text-veko-text"
      >
        <Sun class="theme-icon-sun hidden h-4 w-4 text-amber-400" aria-hidden="true" />
        <Moon class="theme-icon-moon h-4 w-4 text-veko-cyan" aria-hidden="true" />
      </button>

      <a
        href={VEKO_REPO_URL}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Mở kho mã nguồn GitHub của Veko Browser"
        class="inline-flex items-center gap-2 rounded-xl border border-veko-border bg-veko-panel px-3.5 py-2 text-sm font-semibold text-veko-text transition-colors hover:border-veko-cyan/60 hover:bg-veko-card-hover"
      >
        <CodeXml class="h-4 w-4 text-veko-cyan" aria-hidden="true" />
        <span>GitHub</span>
      </a>

      <a
        href={downloadHref}
        class="veko-cta-primary inline-flex items-center gap-2 rounded-xl px-4 py-2 text-sm font-bold shadow-sm transition-transform hover:-translate-y-0.5"
      >
        <Download class="h-4 w-4" aria-hidden="true" />
        <span>Tải về</span>
      </a>
    </div>

    <!-- Cụm điều khiển di động -->
    <div class="flex items-center gap-2 md:hidden">
      <button
        type="button"
        data-theme-toggle
        aria-label="Chuyển đổi giao diện Sáng hoặc Tối"
        class="inline-flex h-11 w-11 items-center justify-center rounded-xl border border-veko-border bg-veko-panel text-veko-muted transition-colors hover:border-veko-cyan/60 hover:text-veko-text"
      >
        <Sun class="theme-icon-sun hidden h-4 w-4 text-amber-400" aria-hidden="true" />
        <Moon class="theme-icon-moon h-4 w-4 text-veko-cyan" aria-hidden="true" />
      </button>

      <button
        id="mobile-menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
        aria-label="Mở hoặc đóng menu điều hướng"
        class="inline-flex h-11 w-11 items-center justify-center rounded-xl border border-veko-border bg-veko-panel text-veko-text transition-colors hover:border-veko-cyan/60"
      >
        <Menu id="mobile-icon-open" class="h-5 w-5" aria-hidden="true" />
        <X id="mobile-icon-close" class="hidden h-5 w-5" aria-hidden="true" />
      </button>
    </div>
  </div>

  <div
    id="mobile-nav-drawer"
    class="hidden border-t border-veko-border/80 bg-veko-surface px-4 pt-3 pb-5 md:hidden"
  >
    <nav aria-label="Điều hướng di động" class="flex flex-col gap-1">
      {
        MAIN_NAV_ITEMS.map((item) => (
          <a
            href={`${homeBase}${item.anchor}`}
            data-mobile-nav-link
            class="rounded-xl px-3.5 py-2.5 text-base font-medium text-veko-muted transition-colors hover:bg-veko-card hover:text-veko-text"
          >
            {item.label}
          </a>
        ))
      }

      <div class="mt-3 grid grid-cols-2 gap-2.5 border-t border-veko-border/60 pt-3">
        <a
          href={VEKO_REPO_URL}
          target="_blank"
          rel="noopener noreferrer"
          data-mobile-nav-link
          class="inline-flex items-center justify-center gap-2 rounded-xl border border-veko-border bg-veko-panel px-4 py-3 text-sm font-semibold text-veko-text"
        >
          <CodeXml class="h-4 w-4 text-veko-cyan" aria-hidden="true" />
          <span>GitHub</span>
        </a>
        <a
          href={downloadHref}
          data-mobile-nav-link
          class="veko-cta-primary inline-flex items-center justify-center gap-2 rounded-xl px-4 py-3 text-sm font-bold"
        >
          <Download class="h-4 w-4" aria-hidden="true" />
          <span>Tải về</span>
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-nav-drawer');
  const iconOpen = document.getElementById('mobile-icon-open');
  const iconClose = document.getElementById('mobile-icon-close');

  function setMenuOpen(open: boolean) {
    if (!toggleBtn || !drawer || !iconOpen || !iconClose) return;
    toggleBtn.setAttribute('aria-expanded', String(open));
    drawer.classList.toggle('hidden', !open);
    iconOpen.classList.toggle('hidden', open);
    iconClose.classList.toggle('hidden', !open);
  }

  toggleBtn?.addEventListener('click', () => {
    const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
    setMenuOpen(!isExpanded);
  });

  document.querySelectorAll('[data-mobile-nav-link]').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      setMenuOpen(false);
    }
  });

  // Đồng bộ nút chuyển giao diện Sáng / Tối trên cả Desktop và Mobile
  const themeButtons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  const metaTheme = document.getElementById('meta-theme-color');

  function syncThemeIcons(theme: 'dark' | 'light') {
    document.querySelectorAll('.theme-icon-sun').forEach((el) => {
      el.classList.toggle('hidden', theme === 'light');
    });
    document.querySelectorAll('.theme-icon-moon').forEach((el) => {
      el.classList.toggle('hidden', theme === 'dark');
    });
    if (metaTheme) {
      metaTheme.setAttribute('content', theme === 'light' ? '#f8fafc' : '#050a14');
    }
  }

  const currentAttr = document.documentElement.getAttribute('data-theme');
  syncThemeIcons(currentAttr === 'light' ? 'light' : 'dark');

  themeButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const active = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
      const next: 'dark' | 'light' = active === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try {
        localStorage.setItem('veko-site-theme', next);
      } catch (_err) {
        // Bỏ qua nếu trình duyệt khóa localStorage
      }
      syncThemeIcons(next);
    });
  });
</script>
