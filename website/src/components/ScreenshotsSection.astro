---
import { Info, ExternalLink } from '@lucide/astro';
import { SCREENSHOT_ITEMS, VEKO_ACTIONS_URL } from '../data/vekoData';
import { withBase } from '../utils/url';
---

<section
  id="giao-dien"
  aria-labelledby="screenshots-heading"
  class="border-t border-veko-border/75 bg-veko-surface/65 py-20 sm:py-28"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl" data-reveal>
      <p class="font-mono text-xs font-bold tracking-widest text-veko-cyan uppercase">
        Minh họa giao diện • UI Mockups (SVG) &amp; CI Screenshots
      </p>
      <h2
        id="screenshots-heading"
        class="mt-2.5 text-balance text-3xl font-extrabold tracking-[-0.025em] text-veko-text sm:text-4xl"
      >
        Trực quan, thoáng mắt và nhất quán trên mọi kích thước màn hình
      </h2>
      <p class="mt-3 text-pretty text-base leading-relaxed text-veko-muted">
        Mọi màn hình trong Veko đều tuân thủ lưới khoảng cách 8dp, độ tương phản rõ nét và vùng chạm tối thiểu 48dp theo chuẩn trợ năng Android.
      </p>
    </div>

    <div
      data-reveal
      class="mt-6 flex flex-col justify-between gap-3 rounded-2xl border border-amber-500/40 bg-veko-panel px-4 py-3.5 text-xs leading-relaxed text-veko-muted sm:flex-row sm:items-center"
    >
      <div class="flex items-start gap-2.5">
        <Info class="mt-0.5 h-4 w-4 shrink-0 text-veko-amber" aria-hidden="true" />
        <span>
          <strong class="font-semibold text-veko-text">Phân biệt rõ UI Mockup và ảnh chụp thực tế:</strong> Bốn hình dưới đây là <strong>bản dựng minh họa vector (SVG UI Mockup)</strong> mô phỏng các Composable để hiển thị nhẹ và sắc nét trên web — <strong>không phải ảnh chụp PNG trực tiếp từ điện thoại đang chạy</strong>. Ảnh chụp PNG thực tế trên máy ảo Android 14 (API 34) được xuất tự động trong gói Artifact của mỗi lần chạy GitHub Actions CI.
        </span>
      </div>
      <a
        href={VEKO_ACTIONS_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex shrink-0 items-center gap-1.5 font-semibold text-veko-cyan hover:underline"
      >
        <span>Xem CI Emulator Screenshots</span>
        <ExternalLink class="h-3.5 w-3.5" aria-hidden="true" />
      </a>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        SCREENSHOT_ITEMS.map((shot) => (
          <figure
            data-reveal
            class="veko-cyber-card flex flex-col justify-between rounded-3xl border border-veko-border bg-veko-panel p-5"
          >
            <div>
              <div class="mb-3 flex flex-wrap items-center justify-between gap-1.5">
                <span class="font-mono text-[10px] font-bold tracking-wider text-veko-cyan uppercase">
                  {shot.tag}
                </span>
                <span class="rounded-full border border-sky-400/35 bg-sky-500/10 px-2 py-0.5 font-mono text-[10px] font-semibold text-veko-cyan">
                  {shot.kindBadge}
                </span>
              </div>

              <div class="flex items-center justify-center rounded-2xl border border-slate-800 bg-[#050A14] p-3">
                <img
                  src={withBase(`/${shot.src}`)}
                  alt={shot.alt}
                  width="360"
                  height="760"
                  sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                  loading="lazy"
                  decoding="async"
                  class="h-auto max-h-[410px] w-auto object-contain"
                />
              </div>
            </div>

            <figcaption class="mt-5">
              <h3 class="text-base font-extrabold text-veko-text">{shot.captionTitle}</h3>
              <p class="mt-1.5 text-xs leading-relaxed text-veko-muted sm:text-sm">
                {shot.captionBody}
              </p>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
