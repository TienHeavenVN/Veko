{
  "name": "veko-browser-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Website giới thiệu chính thức cho Veko Browser — trình duyệt Android tối giản, ưu tiên quyền riêng tư.",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check && tsc --noEmit",
    "lint": "node ./scripts/lint-source.mjs",
    "test:dist": "node ./scripts/verify-dist.mjs",
    "verify": "npm run check && npm run lint && npm run build && npm run test:dist"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@lucide/astro": "^1.66.0",
    "astro": "7.4.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/vite": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
